[Unit]
Description=LabLog paper question AI worker
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
User=lablog-ai
Group=lablog-ai
WorkingDirectory=/opt/lablog-paper-ai
EnvironmentFile=/etc/lablog-paper-ai.env
ExecStart=/opt/lablog-paper-ai/.venv/bin/python /opt/lablog-paper-ai/worker.py
Restart=always
RestartSec=10
TimeoutStopSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
MemoryMax=1G
MemorySwapMax=0
TasksMax=8

[Install]
WantedBy=multi-user.target
